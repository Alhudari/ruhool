# ============================================
# Ruhool (رحول) — Environment Configuration
# ============================================
# Copy to .env and fill in your values. NEVER commit .env to git.
#
# Works with ANY hosting combination:
#   Phase 1: Vercel + Railway + Supabase
#   Phase 2: Local machine + Tailscale (or hybrid)

# ─── Database (any PostgreSQL provider) ───
# Just change the URL — works with Supabase, Neon, Railway, or local.
DATABASE_URL=postgresql://ruhool:password@localhost:5432/ruhool
DB_SSL=false                    # Auto-detected for supabase.co / neon.tech
DB_POOL_MAX=10                  # Reduce to 3-5 for serverless
DB_IDLE_TIMEOUT=20
DB_DISABLE_PREPARE=false        # Set true for Supabase pgBouncer pooling mode

# Docker-compose specific (local dev only)
POSTGRES_USER=ruhool
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_DB=ruhool
POSTGRES_PORT=5432

# ─── File Storage ───
# Switch providers by changing STORAGE_PROVIDER. Zero code changes.
STORAGE_PROVIDER=local          # Values: local, supabase
STORAGE_ROOT=./data             # Only for local provider

# Supabase Storage (when STORAGE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ─── Redis (BullMQ queues) ───
# Optional — falls back to in-process if unavailable.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Temporal (workflow engine) ───
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
TEMPORAL_ADDRESS=localhost:7233

# ─── LLM Providers ───
# At least ONE required. Router auto-selects by model name:
#   claude-*         → Anthropic
#   gpt-*/o1-*/o3-*  → OpenAI
#   gemini-*         → Google
#   gemma*/llama*/mistral* → Ollama (local, free)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434  # Phase 2: Tailscale IP

# ─── Security ───
SESSION_SECRET=                         # Auto-generated if empty
ENCRYPTION_KEY=                         # Auto-generated if empty
RUHOOL_API_TOKEN=                       # REQUIRED in production
NEXT_PUBLIC_API_TOKEN=                  # Same as RUHOOL_API_TOKEN

# ─── API ───
NODE_ENV=development
APP_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001  # Production: https://ruhool-api.up.railway.app

# ─── Web Search (optional) ───
SERPER_API_KEY=
TAVILY_API_KEY=

# ─── Notifications (optional) ───
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SLACK_WEBHOOK_URL=

# ─── Feature Flags ───
ENABLE_HIERARCHICAL_DISPATCH=true   # Hierarchical multi-agent dispatch (CEO → dept → workers)

