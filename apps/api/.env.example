# Ruhool API — environment variables
# Copy to `.env` and fill in values. Restart the API after any edit.

# ─── Shwasha integrations (Zotero + Obsidian) ───

# Zotero Local HTTP Server — default port 23119.
# Enable via Edit → Preferences → Advanced → Config Editor → extensions.zotero.httpServer.enabled = true
# ZOTERO_LOCAL_URL=http://localhost:23119/api

# Obsidian Local REST API plugin (Adam Coddington).
# Copy the API key from the plugin's settings pane.
# OBSIDIAN_API_KEY=
# OBSIDIAN_LOCAL_URL=http://localhost:27123

# Optional subfolder inside the vault where Shwasha notes should land.
# Leave empty to write to the vault root.
# OBSIDIAN_VAULT_FOLDER=References/Shwasha
