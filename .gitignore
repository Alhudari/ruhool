# Environment & secrets
.env
.env.local
.env.production
.env.*.local

# User data (persists locally, never in git) — root-only so we don't
# accidentally ignore source folders named "data" (e.g. apps/api/src/data/).
/data/
/backups/

# Private data (double-ignored for safety)
/data/private/

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.next/
.turbo/
out/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker volumes
postgres-data/
redis-data/
temporal-data/

# Logs
*.log
logs/

# Test
coverage/

# Misc
*.tsbuildinfo

.vercel
supabase/.temp/
