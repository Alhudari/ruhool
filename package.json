{
  "name": "ruhool",
  "version": "0.1.0",
  "private": true,
  "description": "Ruhool (رحول) — Local-first multi-agent orchestration platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "ci": "pnpm install --frozen-lockfile && pnpm turbo run build test lint",
    "db:generate": "pnpm --filter @ruhool/db generate",
    "db:migrate": "pnpm --filter @ruhool/db migrate",
    "db:studio": "pnpm --filter @ruhool/db studio"
  },
  "devDependencies": {
    "next": "14.2.35",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": "^0.25.0"
    }
  }
}
